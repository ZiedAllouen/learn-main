{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "moduleNameMapper": {
    "^@bsmk/db$": "<rootDir>/../../packages/db/src/index.ts",
    "^@bsmk/types$": "<rootDir>/../../packages/types/src/index.ts",
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
