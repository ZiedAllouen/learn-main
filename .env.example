# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bsmk:bsmk_dev@localhost:5432/bsmk_dev

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── NestJS API ────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
NODE_ENV=development

# ── Cloudflare R2 (media storage) ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bsmk-media
R2_PUBLIC_URL=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@bsmk.tn

# ── Cloudflare Turnstile (anti-spam) ──────────────────────────────────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Next.js (web) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_CMS_URL=http://localhost:3002

# ── Payload CMS ───────────────────────────────────────────────────────────────
PAYLOAD_SECRET=change-me-in-production
